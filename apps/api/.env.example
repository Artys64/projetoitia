HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Serviço privado local do multilingual-e5-small; nunca exponha esta porta publicamente.
EMBEDDINGS_URL=http://127.0.0.1:8090
# Base local de artigos. Use caminho absoluto para um arquivo personalizado.
# Vazio usa apps/api/knowledge/articles.json.
KNOWLEDGE_FILE=
KNOWLEDGE_COMPANY_ID=support-hub

# Chat persistente: runtime com papel support_hub_app, sem SUPERUSER/BYPASSRLS.
# Nunca use a credencial administrativa como DATABASE_URL.
DATABASE_URL=
# Somente migrações, provisionamento e importação (comando npm run db).
MIGRATION_DATABASE_URL=
APP_DATABASE_PASSWORD=
# 0 local; 1 apenas atrás do proxy único e confiável configurado no Render.
TRUST_PROXY_HOPS=0
# Origem exata do painel para operações administrativas com cookie (HTTPS em produção).
# Sem configuração, os middlewares recusam escritas administrativas.
ADMIN_ORIGIN=http://localhost:5173
